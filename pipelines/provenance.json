{
  "description": "Provenance registry for GSUA-CSB: which generator produces each rendered or published artifact. Read by octopus_provenance; see python/paper_experiments/*.py for the methods-paper experiments (declared by header).",
  "artifacts": [
    {
      "output": "gsua_userguide.mlx",
      "generator": "docs/gsua_userguide.m",
      "inputs": [
        "docs/gsua_userguide.m",
        "Functions/*.m"
      ],
      "command": "MATLAB desktop: matlab.desktop.editor.openDocument(src).saveAs('gsua_userguide.mlx'); matlab.internal.liveeditor.executeAndSave('gsua_userguide.mlx')"
    },
    {
      "output": "docs/gsua_userguide.html",
      "generator": "docs/gsua_userguide.m",
      "inputs": [
        "docs/gsua_userguide.m",
        "Functions/*.m"
      ],
      "command": "MATLAB: export(<abs>/docs/gsua_userguide.m, 'docs/gsua_userguide.html', 'Run', true, 'Format', 'html')"
    },
    {
      "output": "docs/gsua_userguide.pdf",
